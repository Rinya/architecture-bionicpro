# ===============================================
# BionicPRO Environment Configuration Template
# ===============================================
#
# ИНСТРУКЦИИ:
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Настройте переменные ниже согласно комментариям
# 3. НИКОГДА не коммитьте .env файл в git!
#
# ===============================================

# -----------------------------------------------
# Airflow Configuration (НЕ ИЗМЕНЯТЬ)
# -----------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# -----------------------------------------------
# JWT Security (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
# -----------------------------------------------
# Секретный ключ для подписи JWT токенов аутентификации
#
# КАК СГЕНЕРИРОВАТЬ:
# openssl rand -hex 32
# python -c "import secrets; print(secrets.token_hex(32))"
#
# ПРИМЕР ПРАВИЛЬНОГО КЛЮЧА:
# JWT_SECRET_KEY=a4f8b2c1d5e9f7a3b8c2d6e0f4a7b1c5d8e2f6a0b4c8d2e6f0a4b8c1d5e9f7a3
#
JWT_SECRET_KEY=your-secure-jwt-secret-key-here

# -----------------------------------------------
# Database Passwords (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
# -----------------------------------------------
# Используйте РАЗНЫЕ надежные пароли для каждой БД
# Рекомендации: минимум 16 символов, буквы+цифры+символы

# PostgreSQL для Keycloak (аутентификация)
POSTGRES_KEYCLOAK_PASSWORD=your_secure_keycloak_db_password_here

# PostgreSQL для Airflow (ETL задачи)
POSTGRES_AIRFLOW_PASSWORD=your_secure_airflow_db_password_here
AIRFLOW_ADMIN_PASSWORD=your_secure_airflow_admin_password_here

# ClickHouse (аналитическая OLAP БД)
CLICKHOUSE_USER=bionicpro_user
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password_here
CLICKHOUSE_DB=bionicpro

# Redis (кеширование и очереди)
REDIS_PASSWORD=your_secure_redis_password_here

# -----------------------------------------------
# Admin Users (настроить под ваших админов)
# -----------------------------------------------
# Список пользователей с административными правами (через запятую)
# Можно указывать как username, так и email
ADMIN_USERS=admin,admin@bionicpro.com

# -----------------------------------------------
# Environment Flags (обычно не требует изменений)
# -----------------------------------------------
FLASK_ENV=production
NODE_ENV=production
DEBUG=false

# ===============================================
# ПРОВЕРОЧНЫЙ СПИСОК перед запуском:
# ===============================================
# □ JWT_SECRET_KEY - сгенерирован новый уникальный ключ
# □ POSTGRES_KEYCLOAK_PASSWORD - установлен надежный пароль для Keycloak DB
# □ POSTGRES_AIRFLOW_PASSWORD - установлен надежный пароль для Airflow DB
# □ CLICKHOUSE_PASSWORD - установлен надежный пароль для ClickHouse
# □ REDIS_PASSWORD - установлен надежный пароль для Redis
# □ ADMIN_USERS - указаны ваши администраторы
# □ .env файл НЕ добавлен в git (проверить .gitignore)
# ===============================================