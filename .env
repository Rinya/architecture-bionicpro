# BionicPRO Environment Configuration

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# JWT Security
JWT_SECRET_KEY=bionicpro-jwt-secret-key-2024-super-secure

# Database Passwords
POSTGRES_PASSWORD=secure_postgres_password_2024
CLICKHOUSE_PASSWORD=bionicpro_password
REDIS_PASSWORD=bionicpro_redis_password

# External APIs (configure with your actual URLs)
BITRIX24_WEBHOOK_URL=https://your-company.bitrix24.com/rest/1/your_webhook_key/

# Admin Users (comma-separated)
ADMIN_USERS=admin,admin@bionicpro.com

# Development/Production flags
FLASK_ENV=production
NODE_ENV=production
DEBUG=false