# BionicPRO Reports API Environment Configuration
# Скопируйте этот файл в .env и настройте переменные

# Flask Application
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000

# JWT Authentication
JWT_SECRET_KEY=your-very-secret-jwt-key-here-change-in-production

# ClickHouse Database Connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=bionicpro
CLICKHOUSE_USER=reports_user
CLICKHOUSE_PASSWORD=secure_reports_password_2024!

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
ADMIN_USERS=admin,system_admin

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Development settings
DEBUG=True
TESTING=False

# Production settings (uncomment for production)
# FLASK_ENV=production
# DEBUG=False
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120